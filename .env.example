# ==============================================================================
# e-LMPC RADAR : Environment Variables & Secrets Reference
# ==============================================================================
# Copy this file to .env before starting production containers:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. JWT Authentication & Secret Keys
# ------------------------------------------------------------------------------
# MANDATORY FOR PRODUCTION: Change to a strong, high-entropy 32+ character string.
# In development, a fallback key is used automatically.
JWT_SECRET_KEY=change_this_to_a_secure_random_32_character_secret_key_in_production
JWT_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lmpc_db
# In Docker Compose, the host is 'postgres'. Locally, use 'localhost':
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lmpc_db

# ------------------------------------------------------------------------------
# 3. Network & Service Ports
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Optional Third-Party Registries & Ministry Integrations
# ------------------------------------------------------------------------------
# If your department has access to live GS1 India DataKart or DoCA APIs, provide them here.
# (If omitted, e-LMPC RADAR uses authentic pre-seeded Indian FMCG master records)
# GS1_DATAKART_CLIENT_ID=
# GS1_DATAKART_CLIENT_SECRET=
# DOCA_SMART_CONSUMER_API_KEY=
